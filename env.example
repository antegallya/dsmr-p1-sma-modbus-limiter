# Copy to .env and fill in / verify every value against your own devices
# before setting DRY_RUN=false. See README.md for the arming checklist.

# --- E20 serial device server (DSMR/e-MUCS P1 source) ---
E20_HOST=192.168.1.50
E20_PORT=23

# --- SMA inverter, Modbus TCP ---
INVERTER_HOST=192.168.1.60
INVERTER_PORT=502
INVERTER_UNIT_ID_CTRL=3

# --- Limits ---
# Export limit applied while the daemon actively controls the inverter.
EXPORT_LIMIT_W=2500
# Highest comm-loss fallback power the self-check accepts (defaults to
# EXPORT_LIMIT_W). Can be higher if the house always consumes the
# difference.
FALLBACK_MAX_W=2500

# --- Registers: VERIFY every address/type/scale against this device's own
#     "SMA Modbus register list" before enabling writes. ---
AC_POWER_ADDR=30775
AC_POWER_TYPE=S32
AC_POWER_SCALE=1.0

# No default. Must be the volatile setpoint register (WO), never an
# EEPROM parameter. Per the SBxx-1AV-41 register list (firmware 4.01.15.R):
# 40023 (Inverter.WModCfg.WCtlComCfg.WNomPrc), S16, 0.01 % of
# Inverter.WMax. Alternative: 40149 (Inverter.WModCfg.WCtlComCfg.WSpt),
# with SETPOINT_TYPE=S32, SETPOINT_ENCODING=W, SETPOINT_SCALE=1.0.
SETPOINT_ADDR=40023
SETPOINT_TYPE=S16
SETPOINT_ENCODING=PCT
SETPOINT_SCALE=0.01

# Comm-loss fallback registers, per the SMA register list for SBxx-1AV-41
# firmware 4.01.15.R, pre-2018 country dataset (e.g. Belgium C10/11/2012).
# 41197 (FlbWNom) is a percentage of Inverter.WMax (30233).
FALLBACK_MODE_ADDR=41193
FALLBACK_MODE_TYPE=U32
FALLBACK_TIMEOUT_ADDR=41195
FALLBACK_TIMEOUT_TYPE=U32
FALLBACK_VALUE_ADDR=41197
FALLBACK_VALUE_TYPE=U32
FALLBACK_VALUE_SCALE=0.01
FALLBACK_VALUE_ENCODING=PCT
INVERTER_WMAX_ADDR=30233
INVERTER_WMAX_TYPE=U32

# Read-only status registers. The self-check expects OPERATING_MODE to be
# 1079 ("External active power setpoint"). CURRENT_LIMIT is logged every
# cycle as current_limit_w, to compare with setpoint_w.
OPERATING_MODE_ADDR=30835
OPERATING_MODE_TYPE=U32
CURRENT_LIMIT_ADDR=31405
CURRENT_LIMIT_TYPE=U32

# Refuse to arm when the self-check reports issues.
SELFCHECK_ENFORCE=true

# While AC power reads as the "not implemented" sentinel (inverter not
# producing, e.g. at night): false skips the setpoint write, leaving the
# inverter on its comm-loss fallback; true keeps writing, taking AC power
# as 0 W.
WRITE_WHEN_NOT_PRODUCING=false

# Write WCtlComAct = 802 (Active) on every arm. Without it, setpoint
# writes are accepted but ignored.
COMM_CONTROL_ACTIVATE_ADDR=40151
COMM_CONTROL_ACTIVATE=true

# --- Timing ---
TELEGRAM_STALENESS_MS=3000
RECONNECT_BACKOFF_MIN_MS=500
RECONNECT_BACKOFF_MAX_MS=30000

# --- Safety / ops ---
# Keep true until every register above is checked against the device.
DRY_RUN=true
LOG_LEVEL=info
HEALTH_PORT=8080
